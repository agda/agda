(agda2-status-action "")
(agda2-info-action "*Type-checking*" "" nil nil)
(agda2-highlight-clear)
(agda2-status-action "")
(agda2-info-action "*All Goals*" "?0 : Set ℓ ?1 : Set ℓ" nil t)
((last . 1) . (agda2-goals-action '(0 1)))
(agda2-give-action 0 'no-paren)
(agda2-status-action "")
(agda2-info-action "*All Goals*" "?1 : Set ℓ" nil t)
((last . 1) . (agda2-goals-action '(1)))
(agda2-give-action 1 'no-paren)
(agda2-status-action "")
(agda2-info-action "*All Done*" "" nil t)
((last . 1) . (agda2-goals-action '()))
