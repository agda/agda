-- Regression test for #8910: checking the module application clears the import
-- keyword after its tokens have been consumed by the import declaration.
-- The final application highlighting must restore the import keyword too.
IOTCM currentFile Interactive Direct (Cmd_load currentFile [])
-- The stored highlighting still includes the import keyword.
IOTCM currentFile NonInteractive Direct (Cmd_load_highlighting_info currentFile)
